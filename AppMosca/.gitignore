# ==========================================
# Archivos del Sistema Operativo (macOS)
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ==========================================
# Entorno y Configuración Sensible
# ==========================================
# Ignorar credenciales reales de base de datos y mail
.env
.env.local
.env.development
.env.production

# PERMITIR el archivo de plantilla
!.env.example

# ==========================================
# IDEs y Editores de Código
# ==========================================
# VS Code
.vscode/
*.code-workspace

# JetBrains (PhpStorm, IntelliJ)
.idea/
*.iws
*.iml

# ==========================================
# Gestor de Dependencias (Composer / PHP)
# ==========================================

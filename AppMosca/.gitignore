/vendor/

# PHPMailer instalado manualmente o por composer
# (Descomenta la siguiente línea si phpmailer lo gestionas como librería externa)
# /phpmailer/

# ==========================================
# Archivos Temporales, Logs y Entregas
# ==========================================
*.log
*.tmp
*.temp

# Archivos de exportación temporal/entregas locales en PDF o compilados
*.pdf

# ==========================================
# Caché y Archivos de Compilación
# ==========================================
.phpunit.result.cache
